{
  "name": "goboslice",
  "version": "0.1.0",
  "description": "Browser-based slicer for mask-projection (DLP / µSL) resin printers, built for the BMF microArch S140.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "check": "node build.js --check",
    "test:core": "node --test \"test/*.test.js\"",
    "test:browser": "playwright test",
    "test": "node build.js && node --test \"test/*.test.js\" && playwright test",
    "screenshots": "node scripts/screenshots.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "three": "0.128.0"
  }
}
